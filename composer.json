{
    "name": "clickhouse/laravel",
    "description": "ClickHouse database driver for Laravel — native TCP protocol, typed inserts, zero cURL dependency",
    "type": "library",
    "license": "MIT",
    "keywords": ["clickhouse", "laravel", "database", "analytics", "pdo", "native"],
    "require": {
        "php": "^8.1",
        "ext-pdo": "*",
        "ext-pdo_clickhouse": "*",
        "illuminate/database": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5|^11.0",
        "orchestra/testbench": "^8.0|^9.0|^10.0"
    },
    "autoload": {
        "psr-4": {
            "ClickHouse\\Laravel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ClickHouse\\Laravel\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:unit": "phpunit --testsuite Unit"
    },
    "extra": {
        "laravel": {
            "providers": [
                "ClickHouse\\Laravel\\ClickHouseServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable"
}
